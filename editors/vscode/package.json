{
  "name": "arc-lang",
  "displayName": "Arc Language",
  "description": "Syntax highlighting, IntelliSense, and language support for Arc — a token-efficient language for AI agents",
  "version": "0.1.0",
  "publisher": "KaiBuildsAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kai-builds-ai/arc-lang"
  },
  "homepage": "https://arclang.dev",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "arc",
    "arc-lang",
    "ai",
    "agent",
    "pipeline",
    "token-efficient"
  ],
  "activationEvents": [
    "onLanguage:arc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "arc",
        "aliases": [
          "Arc",
          "arc"
        ],
        "extensions": [
          ".arc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "arc",
        "scopeName": "source.arc",
        "path": "./syntaxes/arc.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
