{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arc",
  "scopeName": "source.arc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#tool-calls" },
    { "include": "#function-def" },
    { "include": "#type-def" },
    { "include": "#constants" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.arc",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.arc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.arc",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.arc",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.arc" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.arc" } },
              "patterns": [{ "include": "source.arc" }]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.arc",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.arc",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.arc",
          "match": "\\b(if|el|match|for|in|do|while|until|ret|async|await)\\b"
        },
        {
          "name": "keyword.declaration.arc",
          "match": "\\b(fn|let|mut|type|use|pub)\\b"
        },
        {
          "name": "keyword.operator.logical.arc",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.arc",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.arc",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.fat-arrow.arc",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.arc",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.arc",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.concat.arc",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.optional.arc",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.comparison.arc",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.arc",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.arc",
          "match": "="
        }
      ]
    },
    "tool-calls": {
      "patterns": [
        {
          "name": "entity.name.function.tool-call.arc",
          "match": "@[A-Z_][A-Za-z0-9_]*"
        }
      ]
    },
    "function-def": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.arc" },
            "2": { "name": "entity.name.function.arc" }
          }
        }
      ]
    },
    "type-def": {
      "patterns": [
        {
          "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.arc" },
            "2": { "name": "entity.name.type.arc" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.arc",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
